# - Config file for the oai_api package
# It defines the following variables
#  oai_api_INCLUDE_DIRS - include directories for FooBar
#  oai_api_LIBRARIES    - libraries to link against
#  oai_api_EXECUTABLE   - the bar executable

set(oai_api_INCLUDE_DIRS "@CONF_INCLUDE_DIRS@")

# Find our dependencies
find_package(cpr REQUIRED)
find_package(fmt REQUIRED)
find_package(OpenCV REQUIRED)
find_package(nlohmann_json REQUIRED)

# Our library dependencies (contains definitions for IMPORTED targets)
include("${oai_api_DIR}/oai_apiTargets.cmake")

# These are IMPORTED targets created by oai_apiTargets.cmake


